MODE=local
LLM_PROVIDER=auto
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=10m
OLLAMA_THINK=false
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE_PATH=./db/model_cache
EMBED_BATCH_SIZE=32
CHROMA_DB_PATH=./db/chroma_store
SOURCE_DB_PATH=./db/source_pages.sqlite3
ORIGINALS_PATH=./db/originals
CACHE_DB_PATH=./db/runtime.sqlite3
WHISPER_MODEL_SIZE=base
WHISPER_BEAM_SIZE=1
MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a token before exposing a private workspace beyond localhost.
# APP_ACCESS_TOKEN=your-workspace-token
# Optional local-only prompt/response trace (contains study material):
# LOG_LLM_CONTENT=1
# Optional free Groq inference (auto uses Groq when a key is configured).
# Material included in prompts is sent to Groq when using this provider.
# MODE=demo
# GROQ_API_KEY=your_free_tier_key
# GROQ_MODEL=openai/gpt-oss-20b
